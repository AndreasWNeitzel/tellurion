# Dependencies
node_modules/
.pnpm-store/
.uv-cache/
.venv/
__pycache__/
*.egg-info/

# Build outputs
dist/
.vite/
*.tsbuildinfo

# Test artifacts: all references/ output is generated and regeneratable
# via scripts/capture-reference.mjs. Nothing under references/ should be
# tracked; it is pixel-regression diagnostic data that goes stale on
# every playground update and provides no user value.
playgrounds/*/references/
playgrounds/*/*/references/
playgrounds/*/failures/
playgrounds/*/*/failures/
playwright-report/
test-results/
coverage/

# Verification markers (regenerated per /verify run)
playgrounds/*/.verified
playgrounds/*/*/.verified

# Internal audit state (regenerated by scripts/audit-*.mjs)
playgrounds/_audit.json

# Multimodal review snapshots (internal QA artifacts)
tests/audit-snaps/

# Internal diagnostic notes
diagnostics/

# Internal docs and process notes. The user-facing references kept
# tracked are docs/CURRICULUM.md, docs/INDEX.md, docs/TAGS.md, and
# docs/CITATIONS.bib. Everything else under docs/ is internal QA,
# audit reports, build-order notes, hero queues, session logs.
CONTRIBUTING.md
NOTES.md
docs/A11Y_REPORT.md
docs/AESTHETIC.md
docs/ARCHITECTURE.md
docs/AUDIT.md
docs/BUILD_ORDER.md
docs/CURRICULUM-BIBLE-BACKLOG.md
docs/FEEDBACK-*.md
docs/HERO-GATES.md
docs/HERO-PROMOTION-QUEUE.md
docs/HERO_VISUAL_STANDARD.md
docs/HEROES.md
docs/INTERACTIVITY_AUDIT.md
docs/NEEDS-ATTENTION.md
docs/PERF_REPORT.md
docs/PLAYGROUND-CATALOGUE.md
docs/PLAYGROUND-LIST.txt
docs/PLAYGROUND_SPEC.md
docs/QUALITY-AUDIT.md
docs/QUALITY-UPGRADE-REPORT.md
docs/QUALITY_AUDIT.md
docs/SESSION-REPORT.md
docs/SMOKE_REPORT.md
docs/STATIC-PLOT-AUDIT.md
docs/VERIFICATION.md

# Scratch / probe scripts (leading underscore is the project's marker)
scripts/_*.mjs

# Benchmark run outputs (timestamped); bench/baseline.json stays tracked
# as the pinned reference for scripts/bench-engines.mjs comparisons.
bench/[0-9]*.json

# Stray log files
*.log

# AI tooling configuration (kept local; not for a public repo).
# .claude/ holds agents, commands, hooks, settings, logs, worktrees;
# CLAUDE.md is the project's local Claude-Code directives file.
# Defensive entries for adjacent tools to keep the public repo clean
# of any AI-assistant traces if those tools get used later.
.claude/
CLAUDE.md
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.continuerules
.windsurfrules
.codeium/
.copilot*

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*~
*.bak

# Python tool caches (these scripts use Python for some build steps)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Raw card-image source drop (heavy input; derive assets/thumbs via
# scripts/build-card-thumbs.mjs, which is committed)
images/

# Local archive of superseded playgrounds. Kept on the maintainer's
# disk for reference and possible future restoration. Never deployed.
_archive/
