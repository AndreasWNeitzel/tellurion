# Dependencies
node_modules/
.pnpm-store/
.uv-cache/
.venv/
__pycache__/
*.egg-info/

# Build outputs
dist/
.vite/
*.tsbuildinfo

# Test artifacts (ephemeral; goldens live under references/golden-frames/ and are committed)
# Both the legacy flat layout playgrounds/<slug>/ and the curriculum-aligned
# playgrounds/<year>/<UC>-<slug>/ layout are covered.
playgrounds/*/references/captured/
playgrounds/*/*/references/captured/
playgrounds/*/failures/
playgrounds/*/*/failures/
playwright-report/
test-results/
coverage/

# Verification markers (regenerated per /verify run)
playgrounds/*/.verified
playgrounds/*/*/.verified

# AI tooling configuration (kept local; not for a public repo).
# .claude/ holds agents, commands, hooks, settings, logs, worktrees;
# CLAUDE.md is the project's local Claude-Code directives file.
# Defensive entries for adjacent tools to keep the public repo clean
# of any AI-assistant traces if those tools get used later.
.claude/
CLAUDE.md
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.continuerules
.windsurfrules
.codeium/
.copilot*

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*~
*.bak

# Python tool caches (these scripts use Python for some build steps)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Raw card-image source drop (heavy input; derive assets/thumbs via
# scripts/build-card-thumbs.mjs, which is committed)
images/
