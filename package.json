{
  "name": "tellurion",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "description": "Tellurion: Canvas2D and SVG physics and ML playgrounds. Public site at tellurion.dev.",
  "homepage": "https://tellurion.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreasWNeitzel/tellurion.git"
  },
  "bugs": {
    "url": "https://github.com/AndreasWNeitzel/tellurion/issues",
    "email": "andreaswneitzel@gmail.com"
  },
  "author": {
    "name": "Andreas W. Neitzel",
    "email": "andreaswneitzel@gmail.com",
    "url": "https://orcid.org/0000-0001-6283-907X"
  },
  "license": "MIT",
  "keywords": [
    "physics",
    "astronomy",
    "interactive",
    "simulation",
    "education",
    "canvas",
    "svg",
    "webgl",
    "playground",
    "tellurion"
  ],
  "scripts": {
    "scaffold": "bash scripts/scaffold.sh",
    "capture": "node scripts/capture-reference.mjs",
    "verify": "bash scripts/verify-all.sh",
    "test:engines": "vitest run tests/engines",
    "bench": "node scripts/bench-engines.mjs",
    "build:index": "node scripts/build-index.mjs",
    "test:invariants": "vitest run \"playgrounds/*/invariants.test.mjs\"",
    "test:visual": "playwright test \"playgrounds/*/visual.test.mjs\"",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint shared playgrounds scripts tests --max-warnings 0",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,md,css,html,json}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "eslint": "^9.7.0",
    "happy-dom": "^20.9.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.2",
    "ssim.js": "^3.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
