{
  "name": "playgrounds-portfolio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Canvas2D and SVG physics and ML playgrounds for portfolio use.",
  "scripts": {
    "scaffold": "bash scripts/scaffold.sh",
    "capture": "node scripts/capture-reference.mjs",
    "verify": "bash scripts/verify-all.sh",
    "test:engines": "vitest run tests/engines",
    "test:invariants": "vitest run \"playgrounds/*/invariants.test.mjs\"",
    "test:visual": "playwright test \"playgrounds/*/visual.test.mjs\"",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint shared playgrounds scripts tests --max-warnings 0",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,md,css,html,json}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "eslint": "^9.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.2",
    "ssim.js": "^3.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.11"
  }
}
